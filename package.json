{
  "name": "vesper-desk",
  "version": "1.0.1-pre.18",
  "description": "Vesper Desk — multi-stream Twitch desktop",
  "main": "./out/main/index.js",
  "author": "Justin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.justin.vesperdesk",
    "productName": "Vesper Desk",
    "copyright": "Copyright © Justin",
    "asar": true,
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Justin-Developer01",
        "repo": "vesper-desk"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Vesper Desk",
      "uninstallDisplayName": "Vesper Desk",
      "artifactName": "Vesper-Desk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Vesper-Desk-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.1",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-grid-layout": "^1.3.5",
    "@types/tmi.js": "^1.8.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "electron@34.2.0": true,
    "esbuild@0.25.12": true
  }
}
