{
  "name": "stream-watcher",
  "version": "1.0.1-pre.15",
  "description": "Multi-stream Twitch desktop viewer with custom layouts and chat",
  "main": "dist-electron/main.js",
  "author": "Justin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "SW_DESKTOP=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.justin.streamwatcher",
    "productName": "Stream Watcher",
    "copyright": "Copyright © Justin",
    "asar": true,
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Justin-Developer01",
        "repo": "stream-watcher"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Stream Watcher",
      "uninstallDisplayName": "Stream Watcher",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.1",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-grid-layout": "^1.3.5",
    "@types/tmi.js": "^1.8.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "allowScripts": {
    "electron@34.2.0": true,
    "esbuild@0.25.12": true
  }
}
